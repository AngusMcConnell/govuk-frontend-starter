{
  "name": "apply-juggling-license",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon /app/server",
    "format": "prettier . --write",
    "lint:css": "stylelint 'app/**/*.css'",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js",
    "start": "node app/server",
    "test": "playwright test --ui",
    "typecheck:client": "tsc -p app/client/jsconfig.json",
    "typecheck:server": "tsc -p app/server/jsconfig.json",
    "typecheck:tests": "tsc --p tests/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "validate": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.0.6",
    "@types/nunjucks": "^3.2.6",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "govuk-frontend": "^5.14.0",
    "govuk-markdown": "^0.8.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.7",
    "http-errors": "^2.0.0",
    "marked": "^17.0.1",
    "morgan": "^1.10.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.10",
    "@types/express": "^5.0.6",
    "@types/govuk-frontend": "^5.11.0",
    "@types/node": "^22.19.7",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.1.0",
    "nodemon": "^3.1.10",
    "prettier": "3.8.1",
    "stylelint": "^16.24.0",
    "stylelint-config-gds": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "stylelint": {
    "extends": "stylelint-config-gds/css"
  }
}
